// Classic ShokaX turns the desktop sidebar from normal flow into `fixed` while
// the page scrolls. On pages that reach the footer this can repeatedly change
// the document height, producing a visible flash. Make the sidebar sticky for
// every page instead, so its geometry never changes during scrolling.
@media (min-width: 992px) {
  #sidebar,
  #sidebar.affix {
    overflow: visible;
    align-self: stretch;
    transition: none !important;
  }

  #sidebar > .inner,
  #sidebar.affix > .inner {
    position: sticky;
    top: 0;
    transition: none !important;
  }

  #sidebar .panels,
  #sidebar.affix .panels {
    height: auto;
    min-height: 0;
    padding-top: 4.6875rem;
  }
}

// The floating controls also switch their position at the same scroll point.
// Removing that transition avoids a second compositor repaint at the footer.
#tool,
#tool.affix {
  transition: none !important;
}

.cursor-snowflake {
  position: fixed;
  z-index: 9999999;
  border-radius: 50%;
  pointer-events: none;
  background: rgba(255, 255, 255, .95);
  box-shadow: 0 0 .4rem rgba(255, 255, 255, .85);
  will-change: transform, opacity;
  animation: cursor-snowfall var(--snow-duration) ease-out forwards;
}

@keyframes cursor-snowfall {
  from {
    opacity: .95;
    transform: translate3d(0, 0, 0) rotate(0deg);
  }
  to {
    opacity: 0;
    transform: translate3d(var(--snow-drift), 7rem, 0) rotate(180deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .cursor-snowflake {
    display: none;
  }
}
