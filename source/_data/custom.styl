// Classic ShokaX changes the desktop sidebar's layout when the page crosses a
// scroll threshold. That changes the document height near the footer and lets
// the browser's scroll anchoring pull the viewport back upward. The companion
// script keeps the sidebar in its original in-flow desktop state. These rules
// make that state stable on every page.
html {
  overflow-anchor: none;
}

@media (min-width: 992px) {
  #sidebar,
  #sidebar.affix {
    overflow: visible;
    scrollbar-width: none;
    transition: none !important;
  }

  #sidebar::-webkit-scrollbar,
  #sidebar.affix::-webkit-scrollbar {
    display: none;
  }

  #sidebar > .inner,
  #sidebar.affix > .inner {
    position: relative;
    transition: none !important;
  }

  #sidebar .panels,
  #sidebar.affix .panels {
    height: auto;
    min-height: 100vh;
    padding-top: 4.6875rem;
  }

  #sidebar .tab,
  #sidebar.affix .tab {
    padding-top: 1.875rem;
  }
}

// Hide the sidebar's up/down page-navigation shortcuts.
#quick,
#sidebar.affix #quick,
#sidebar.on #quick {
  display: none !important;
}

// Keep the homepage hero as one still background instead of ShokaX's rotating,
// zooming cover slideshow. The first selected cover remains visible.
#imgs .item {
  animation: none !important;
  transform: none !important;
  opacity: 0 !important;
}

#imgs .item:first-child {
  opacity: 1 !important;
}

#imgs::before {
  background: transparent !important;
  transition: none !important;
}

// Use the homepage banner behind every page header. Article cover images stay
// available inside their articles and on index cards, but are not used here.
#imgs {
  background-image: url('https://clan.akamai.steamstatic.com/images//25278042/f446843fd9328318463318c4ec624a9d9ba0f9ca.png') !important;
  background-position: center !important;
  background-repeat: no-repeat !important;
  background-size: cover !important;
}

#imgs > img {
  content: url('https://clan.akamai.steamstatic.com/images//25278042/f446843fd9328318463318c4ec624a9d9ba0f9ca.png') !important;
  opacity: 1 !important;
}

// Do not leave later homepage entries invisible if the theme's intersection
// observer misses its 30% visibility threshold near the bottom of the feed.
// Opacity only preserves ShokaX's native alternating two-column layout.
.segments > .item {
  opacity: 1 !important;
}

// The floating controls also switch their position at the same scroll point.
// Removing that transition avoids a second compositor repaint at the footer.
#tool,
#tool.affix {
  transition: none !important;
}

// ShokaX 0.5.4 still ships the old rule that permanently hides the music
// panel button. Nyx Player owns this button now, so expose it whenever the
// original player module is enabled.
#tool .player #showBtn {
  display: block;
}

.cursor-snowflake {
  position: fixed;
  z-index: 9999999;
  pointer-events: none;
  color: #fff;
  font-family: Arial, sans-serif;
  font-weight: 700;
  line-height: 1;
  text-shadow: 0 0 .45rem rgba(255, 255, 255, .95), 0 0 .9rem rgba(173, 216, 255, .7);
  will-change: transform, opacity;
  animation: cursor-snowfall var(--snow-duration) ease-out forwards;
}

@keyframes cursor-snowfall {
  from {
    opacity: .95;
    transform: translate3d(0, 0, 0) rotate(0deg);
  }
  to {
    opacity: 0;
    transform: translate3d(var(--snow-drift), 7rem, 0) rotate(180deg);
  }
}


// A simple, valid archive layout that remains readable on both color schemes.
.timeline-archive {
  max-width: 56rem;
  padding-top: 2.5rem;
  padding-bottom: 4rem;
}

.timeline-archive__summary {
  margin: 0 0 2rem;
  color: var(--grey, #8a8a8a);
  font-size: .9rem;
}

.timeline-archive__year {
  margin: 0 0 2.75rem;
}

.timeline-archive__year h2 {
  margin: 0 0 1rem;
  padding-bottom: .55rem;
  border-bottom: 1px solid var(--grey-light, rgba(127, 127, 127, .25));
  font-size: 2rem;
  line-height: 1.1;
}

.timeline-archive__year ol {
  margin: 0;
  padding: 0;
  list-style: none;
}

.timeline-archive__post {
  display: flex;
  align-items: baseline;
  gap: 1rem;
  padding: .55rem .25rem;
  border-bottom: 1px dashed var(--grey-light, rgba(127, 127, 127, .2));
}

.timeline-archive__post time {
  flex: 0 0 3.4rem;
  color: var(--grey, #8a8a8a);
  font-variant-numeric: tabular-nums;
}

.timeline-archive__post a {
  color: var(--text-color, inherit);
  font-size: 1.02rem;
  text-decoration: none;
}

.timeline-archive__post a:hover {
  color: var(--primary-color, #f06d8f);
}

@media (max-width: 480px) {
  .timeline-archive__post {
    gap: .65rem;
  }

  .timeline-archive__year h2 {
    font-size: 1.65rem;
  }
}

// Soft, compact Waline card that follows ShokaX light/dark mode.
#comments {
  --waline-theme-color: #ef86a4;
  --waline-active-color: #e7658d;
  --waline-color: #5f5961;
  --waline-bg-color: rgba(255, 249, 252, .92);
  --waline-bg-color-light: #fff4f8;
  --waline-bg-color-hover: #ffeaf1;
  --waline-border-color: rgba(222, 154, 177, .32);
  --waline-disable-bg-color: #f4edf0;
  --waline-disable-color: #aaa0a5;
  margin-top: 2rem;
  padding: 1.15rem;
  border: 1px solid rgba(222, 154, 177, .28);
  border-radius: 1.35rem;
  background: linear-gradient(145deg, rgba(255,255,255,.96), rgba(255,240,246,.9));
  box-shadow: 0 .75rem 2rem rgba(194, 105, 139, .12);
}

#comments .wl-panel,
#comments .wl-editor,
#comments .wl-input {
  border-radius: .9rem;
}

#comments .wl-btn.primary {
  border: 0;
  border-radius: 999px;
  background: linear-gradient(135deg, #f29ab3, #e96f98);
  box-shadow: 0 .35rem .9rem rgba(233, 111, 152, .25);
}

.waline-status {
  margin: 0;
  color: #b47b90;
  text-align: center;
  font-size: .9rem;
}

html[data-theme="dark"] #comments {
  --waline-theme-color: #f09ab6;
  --waline-active-color: #ffb1c8;
  --waline-color: #d8d0d5;
  --waline-white: #252329;
  --waline-bg-color: #29272e;
  --waline-bg-color-light: #323039;
  --waline-bg-color-hover: #393640;
  --waline-border-color: #4b4652;
  --waline-disable-bg-color: #35323a;
  --waline-disable-color: #8f8892;
  border-color: rgba(240, 154, 182, .18);
  background: linear-gradient(145deg, #29272e, #242229);
  box-shadow: 0 .8rem 2rem rgba(0, 0, 0, .28);
}

html[data-theme="dark"] #comments .wl-editor,
html[data-theme="dark"] #comments .wl-input,
html[data-theme="dark"] #comments textarea,
html[data-theme="dark"] #comments input {
  color: #eee8ec !important;
  background: #211f25 !important;
}
